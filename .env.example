# Optional: enables the AI Advisor tab.
# Get a key from https://console.anthropic.com (pay-as-you-go, separate from a Claude subscription).
# Copy this file to ".env" and fill in your key, then restart the server.
# Without it, the app works fully — only the Advisor tab shows a "not configured" message.
ANTHROPIC_API_KEY=

# Recommended for deployment: a Postgres connection string for persistent storage.
# Without it, data is stored in a local file (data/db.json) that is wiped whenever
# a host with an ephemeral disk (e.g. Render free) restarts — which logs everyone out.
# Free Postgres: https://neon.tech  (copy the "connection string")
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Optional: change the port (default 5173)
# PORT=5173

# Optional: enables the "Forgot password" email flow.
# Get a key from https://resend.com (free tier: 100 emails/day).
# Without it, the reset screens explain that recovery isn't configured.
RESEND_API_KEY=re_8q2aQFkH_GrVXopBcfMmQtzzJxAg9zVqh

# The public base URL put into reset links. On Render, RENDER_EXTERNAL_URL is
# used automatically — set this only for a custom domain or local testing.
# APP_URL=http://localhost:5173

# Sender address. The default uses Resend's shared onboarding@resend.dev, which
# can only deliver to your own Resend signup address. Verify a domain to send
# anywhere, then set e.g. MAIL_FROM="Expense Tracker <noreply@yourdomain.com>".
# MAIL_FROM=
